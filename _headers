# Security headers. Netlify and Cloudflare Pages read this file automatically.
# On another host, set the same headers in that host's config.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' https://js.hsforms.net https://js.hsforms.com https://js.hs-scripts.com https://js.hs-analytics.net https://js.hs-banner.com https://js.usemessages.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://*.hsforms.net https://*.hsforms.com; connect-src 'self' https://forms.hsforms.com https://api.hsforms.com https://*.hubspot.com; base-uri 'self'; form-action 'self' https://forms.hsforms.com; object-src 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable
